# MRPL AI Workbench Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-mrpl-ai-workbench-pc5-local-secret-key-change-in-production

# ---- Local AI (Ollama) -------------------------------------------------------
# All inference is local. Models are defined in backend/chat/model_registry.py
# (verify with: python manage.py check_local_models). There is no cloud AI option.
OLLAMA_URL=http://127.0.0.1:11434
# Private-LAN hosts/IPs/CIDRs allowed for OLLAMA_URL (loopback is always allowed,
# public and link-local addresses are always refused), e.g. 192.168.1.50 or 10.20.0.0/16
OLLAMA_ALLOWED_HOSTS=
# Routing default when a client does not specify one (ids: qwen3 | qwen-coder | qwen-vl)
DEFAULT_CHAT_MODEL=qwen3
OLLAMA_TIMEOUT=300
# Context window per request (8192 fits every model on an 8 GB GPU; Ollama default 4096)
OLLAMA_NUM_CTX=8192
# Qwen3 thinking: empty = model default (on), false = answer directly (faster), true = force on
OLLAMA_THINK=

# ---- Vision images -------------------------------------------------------------
VISION_MAX_SIDE=1024
VISION_MAX_INPUT_PIXELS=50000000
MAX_IMAGES_PER_MESSAGE=3
# PDF pages the vision model may see per question ("describe page 3", "pages 2-3")
VISION_MAX_PDF_PAGES=2

# ---- Conversation context -------------------------------------------------------
CONTEXT_MAX_MESSAGES=12
CONTEXT_IMAGE_TURNS=8

# ---- Documents & OCR -----------------------------------------------------------
DOCUMENT_MAX_CHARS=50000
DOCUMENT_MAX_PDF_PAGES=300
OCR_LANG=en
# Languages users may pick per upload: en,hi,mr,ka,ta,te,ml,ch,latin (each downloads its model once)
OCR_ALLOWED_LANGS=en
# server (default, most accurate, ~20 s/page on CPU) | mobile (~3x faster)
OCR_MODEL_PROFILE=server
# Page-orientation correction (fixes rotated scans); text-line orientation / unwarping stay off
OCR_USE_DOC_ORIENTATION=true
OCR_USE_TEXTLINE_ORIENTATION=false
OCR_USE_UNWARPING=false
OCR_PDF_DPI=200
OCR_MAX_PDF_PAGES=20
OCR_CPU_THREADS=8

# ---- Network & Host Settings for LAN -------------------------------------------
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
