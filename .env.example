# MRPL AI Workbench Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-mrpl-ai-workbench-pc5-local-secret-key-change-in-production

# ---- Local AI (Ollama) -------------------------------------------------------
# All inference is local. Models are defined in backend/chat/model_registry.py
# (verify with: python manage.py check_local_models). There is no cloud AI option.
OLLAMA_URL=http://127.0.0.1:11434
# Private-LAN hosts/IPs/CIDRs allowed for OLLAMA_URL (loopback is always allowed,
# public and link-local addresses are always refused), e.g. 192.168.1.50 or 10.20.0.0/16
OLLAMA_ALLOWED_HOSTS=
# Routing default when a client does not specify one (ids: qwen3 | qwen-coder | qwen-vl)
DEFAULT_CHAT_MODEL=qwen3
OLLAMA_TIMEOUT=300
# Context window per request (8192 fits every model on an 8 GB GPU; Ollama default 4096)
OLLAMA_NUM_CTX=8192
# Qwen3 thinking default: false = answer directly (fast, default); true = always reason step by step.
# Users can still turn on "Think deeper" per message in the UI.
OLLAMA_THINK=false
# How long a model stays in GPU memory after its last request (avoids reloading)
OLLAMA_KEEP_ALIVE=30m
# Load the likely model into GPU memory when the page opens / the model changes / an image is attached
OLLAMA_WARMUP=true
# One request on the GPU at a time; others wait up to OLLAMA_QUEUE_TIMEOUT seconds (then "busy")
OLLAMA_MAX_CONCURRENT=1
OLLAMA_QUEUE_TIMEOUT=180

# Reliability instructions sent to every model (reduces unsupported claims; true/false)
RELIABILITY_INSTRUCTIONS=true

# ---- Vision images -------------------------------------------------------------
VISION_MAX_SIDE=1024
VISION_MAX_INPUT_PIXELS=50000000
MAX_IMAGES_PER_MESSAGE=3
# PDF pages the vision model may see per question ("describe page 3", "pages 2-3")
VISION_MAX_PDF_PAGES=2
# "Describe every page": pages analysed in batches of VISION_MAX_PDF_PAGES, up to this many
VISION_OVERVIEW_MAX_PAGES=6
# Image + coding request: vision model describes the image, then the coder writes the code
VISION_CODING_CHAIN=true

# ---- Conversation context -------------------------------------------------------
CONTEXT_MAX_MESSAGES=12
CONTEXT_IMAGE_TURNS=8

# ---- Documents & OCR -----------------------------------------------------------
DOCUMENT_MAX_CHARS=50000
DOCUMENT_MAX_PDF_PAGES=300
# Extract text / OCR in a background worker (upload returns at once, UI shows progress)
DOCUMENT_ASYNC_PROCESSING=true
OCR_LANG=en
# Languages users may pick per upload: en,hi,mr,ka,ta,te,ml,ch,latin (each downloads its model once)
OCR_ALLOWED_LANGS=en
# mobile (default, ~6 s/page on CPU) | server (slower, ~20 s/page; use on a stronger server)
OCR_MODEL_PROFILE=mobile
# Pages whose OCR confidence is below OCR_VISION_FALLBACK_BELOW are transcribed by the vision model
OCR_VISION_FALLBACK=true
OCR_VISION_FALLBACK_BELOW=0.80
# Free the OCR engine's memory after this many idle seconds (0 = keep loaded)
OCR_IDLE_UNLOAD_SECONDS=600
# Page-orientation correction (fixes rotated scans); text-line orientation / unwarping stay off
OCR_USE_DOC_ORIENTATION=true
OCR_USE_TEXTLINE_ORIENTATION=false
OCR_USE_UNWARPING=false
OCR_PDF_DPI=200
OCR_MAX_PDF_PAGES=20
OCR_CPU_THREADS=8

# ---- Local knowledge store (Qdrant Edge + local embeddings) -----------------------
# Document sections are embedded locally (ollama pull qwen3-embedding:0.6b) and stored in an
# embedded Qdrant Edge shard; questions use hybrid semantic + BM25 retrieval. false = BM25 only.
KNOWLEDGE_INDEXING=true
# KNOWLEDGE_STORE_DIR=/path/to/knowledge_store   (default: backend/knowledge_store)
EMBEDDING_MODEL=qwen3-embedding:0.6b
# cpu = keep the embedding model off the GPU (chat model stays loaded); gpu = faster indexing
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# Added to the semantic score of sections containing the query's identifiers (tags, report numbers)
KNOWLEDGE_IDENTIFIER_BOOST=0.2
EMBEDDING_TIMEOUT=120
EMBEDDING_KEEP_ALIVE=30m

# ---- Data classification ------------------------------------------------------------
# public | shareable | internal | confidential. Only public/shareable may ever leave the site.
DEFAULT_CLASSIFICATION=internal
# Allow lowering a document below what its content scan found (audited). false = refused.
CLASSIFICATION_ALLOW_OVERRIDE=false
# Sections given to the model for a knowledge-base question
KNOWLEDGE_QA_MAX_SOURCES=8

# ---- Monitoring ------------------------------------------------------------------
# Usage rows older than this are removed by: python manage.py prune_usage --apply
USAGE_RETENTION_DAYS=365

# ---- Network & Host Settings for LAN -------------------------------------------
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
