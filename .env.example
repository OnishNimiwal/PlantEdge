# MRPL AI Workbench Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-mrpl-ai-workbench-pc5-local-secret-key-change-in-production

# Ollama Local AI Settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
ALLOW_EXTERNAL_AI=False

# Multi-model chat (ids from backend/chat/model_registry.py: qwen3 | qwen-coder | qwen-vl)
DEFAULT_CHAT_MODEL=qwen3
OLLAMA_TIMEOUT=300

# Network & Host Settings for LAN
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
